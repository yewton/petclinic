{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices"
  ],
  "dependencyDashboard": true,
  "osvVulnerabilityAlerts": true,
  "ignorePaths": [
    "libs/**"
  ],
  "packageRules": [
    {
      "description": "Spring Boot のマネージドバージョンに合わせて手動更新するため Renovate 対象外",
      "matchPackageNames": [
        "org.jetbrains.kotlin:{/,}**",
        "org.jooq:{/,}**",
        "io.spring.gradle:dependency-management-plugin"
      ],
      "enabled": false
    },
    {
      "description": "Patch、minor、GitHub Actions digest 更新は自動マージする。リポジトリで GitHub の auto-merge が無効なため、プラットフォーム側ではなく Renovate 自身にマージさせる",
      "matchUpdateTypes": [
        "patch",
        "minor",
        "digest"
      ],
      "automerge": true,
      "platformAutomerge": false
    }
  ]
}
