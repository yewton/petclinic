{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices"
  ],
  "dependencyDashboard": true,
  "osvVulnerabilityAlerts": true,
  "ignorePaths": [
    "libs/**"
  ],
  "packageRules": [
    {
      "description": "Spring Boot のマネージドバージョンに合わせて手動更新するため Renovate 対象外",
      "matchPackageNames": [
        "org.jetbrains.kotlin:{/,}**",
        "org.jooq:{/,}**",
        "io.spring.gradle:dependency-management-plugin"
      ],
      "enabled": false
    },
    {
      "description": "Gradle verification-metadata.xml はアップデート対象外 (Gradle が自動管理)",
      "matchFileNames": [
        "gradle/verification-metadata.xml"
      ],
      "enabled": false
    }
  ]
}
