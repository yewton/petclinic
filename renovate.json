{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices"
  ],
  "dependencyDashboard": true,
  "osvVulnerabilityAlerts": true,
  "ignorePaths": [
    "libs/**"
  ],
  "packageRules": [
    {
      "description": "Spring Boot のマネージドバージョンに合わせて手動更新するため Renovate 対象外",
      "matchPackageNames": [
        "org.jetbrains.kotlin:{/,}**",
        "org.jooq:{/,}**",
        "io.spring.gradle:dependency-management-plugin"
      ],
      "enabled": false
    },
    {
      "description": "Patch と minor は自動マージする。リポジトリで GitHub の auto-merge が無効なため、プラットフォーム側ではなく Renovate 自身にマージさせる",
      "matchUpdateTypes": [
        "patch",
        "minor"
      ],
      "automerge": true,
      "platformAutomerge": false
    },
    {
      "description": "GitHub Actions の digest 更新は自動マージする。Docker digest はレビューを挟むため対象外",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "digest"
      ],
      "automerge": true,
      "platformAutomerge": false
    },
    {
      "description": "patch、minor、digest の更新は、Renovate が取得できるリリース時刻を基準に原則3日待機する。security update は待機を迂回し、GitHub Actions の digest 更新は digest の変更時刻ではなく対応するバージョンの commit timestamp を基準にする",
      "matchUpdateTypes": [
        "patch",
        "minor",
        "digest"
      ],
      "minimumReleaseAge": "3 days"
    }
  ]
}
