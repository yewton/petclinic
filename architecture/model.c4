model {
  petOwner = person 'Pet owner' {
    description 'Registers pets and books visits with the clinic'
  }

  grafana = softwareSystem 'Grafana observability stack' {
    description 'External LGTM stack that receives and visualises telemetry'

    alloy = container 'Alloy' {
      description 'OpenTelemetry collector; telemetry entry point'
      technology 'Grafana Alloy'
    }
    tempo = database 'Tempo' {
      technology 'Traces'
    }
    loki = database 'Loki' {
      technology 'Logs'
    }
    mimir = database 'Mimir' {
      technology 'Metrics'
    }
    grafanaUi = container 'Grafana' {
      description 'Dashboards and exploration'
    }

    alloy -[telemetry]-> tempo 'forwards traces'
    alloy -[telemetry]-> loki 'forwards logs'
    alloy -[telemetry]-> mimir 'forwards metrics'
    grafanaUi -[uses]-> tempo 'queries traces'
    grafanaUi -[uses]-> loki 'queries logs'
    grafanaUi -[uses]-> mimir 'queries metrics'
  }

  petclinic = softwareSystem 'PetClinic' {
    description 'Spring PetClinic re-implementation with parallel HTML and HTMX frontends'

    core = library 'Core library' {
      #shared
      description 'Shared domain logic compiled into both application containers'
      technology 'Kotlin, Spring WebFlux, jOOQ, R2DBC'

      ownerDomain = component 'Owner domain'
      petDomain = component 'Pet domain'
      visitDomain = component 'Visit domain'
      vetDomain = component 'Vet directory'
      domainModel = component 'Shared domain model'

      ownerDomain -[uses]-> domainModel
      ownerDomain -[uses]-> petDomain
      petDomain -[uses]-> domainModel
      petDomain -[uses]-> visitDomain
      visitDomain -[uses]-> domainModel
      vetDomain -[uses]-> domainModel
    }

    htmlApp = container 'PetClinic HTML' {
      #fullstack-html
      #parallel-implementation
      description 'Server-rendered full-page application'
      technology 'Spring WebFlux, Thymeleaf'

      htmlOwnerWeb = component 'Owner pages'
      htmlPetWeb = component 'Pet pages'
      htmlVisitWeb = component 'Visit pages'
      htmlVetWeb = component 'Vet pages'
    }

    htmxApp = container 'PetClinic HTMX' {
      #fullstack-htmx
      #parallel-implementation
      description 'Server-rendered application with HTMX partial rendering'
      technology 'Spring WebFlux, Thymeleaf, HTMX'

      htmxOwnerWeb = component 'Owner pages'
      htmxPetWeb = component 'Pet pages'
      htmxVisitWeb = component 'Visit pages'
      htmxVetWeb = component 'Vet pages'
    }

    db = database 'Database' {
      description 'Owners, pets, visits, vets, and specialties'
      technology 'PostgreSQL 16 via R2DBC'
    }

    petOwner -[http]-> htmlApp 'views and manages owners, pets, and visits'
    petOwner -[http]-> htmxApp 'views and manages owners, pets, and visits'

    htmlOwnerWeb -[uses]-> ownerDomain
    htmlPetWeb -[uses]-> petDomain
    htmlVisitWeb -[uses]-> visitDomain
    htmlVetWeb -[uses]-> vetDomain
    htmxOwnerWeb -[uses]-> ownerDomain
    htmxPetWeb -[uses]-> petDomain
    htmxVisitWeb -[uses]-> visitDomain
    htmxVetWeb -[uses]-> vetDomain

    core -[persistence]-> db 'reads and writes domain data'

    htmlApp -[otlp]-> alloy 'exports traces, logs, and metrics'
    htmxApp -[otlp]-> alloy 'exports traces, logs, and metrics'

    htmlApp -[correspondence]-> htmxApp 'equivalent feature set; no build or runtime dependency'
  }
}
