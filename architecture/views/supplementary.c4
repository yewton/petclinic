// 補助ビュー — C4 の梯子には含まない

views {
  // 両アプリケーションから Grafana スタックへのテレメトリの流れ。
  view observability {
    title '観測性パイプライン'
    include petclinic.htmlApp, petclinic.htmxApp
    include grafana, grafana.*
    exclude petclinic.htmlApp -> petclinic.htmxApp
  }

  // fullstack-html と fullstack-htmx は機能同等の並行実装。
  // correspondence 関係は機能の同等性を表すもので、依存関係ではない。
  view parallelImplementation {
    title '並行実装 — HTML と HTMX'
    include petclinic.htmlApp, petclinic.htmxApp
  }
}
