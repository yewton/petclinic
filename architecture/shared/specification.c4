specification {
  element external-actor {
    style {
      shape person
      color green
    }
  }
  element system {
    style {
      color primary
      border solid
    }
  }
  element application {
    style {
      shape browser
      color secondary
    }
  }
  element shared-library {
    style {
      shape component
      color indigo
    }
  }
  element domain-component {
    style {
      shape component
      color muted
    }
  }
  element data-store {
    style {
      shape cylinder
      color amber
    }
  }
  element observability-component {
    style {
      shape component
      color red
    }
  }

  relationship dependency
  relationship http
  relationship otlp {
    line dotted
    color red
  }
  relationship telemetry
  relationship correspondence {
    line dotted
    color green
  }

  tag fullstack-html {
    color #4C78A8
  }
  tag fullstack-htmx {
    color #F58518
  }
  tag parallel-implementation {
    color #54A24B
  }
}
