model {
  pet-owner = external-actor 'Pet owner'
  postgres = data-store 'PostgreSQL' {
    technology 'PostgreSQL via R2DBC'
  }
  grafana-stack = system 'Grafana observability stack' {
    alloy = observability-component 'Alloy' {
      technology 'OpenTelemetry Protocol (OTLP)'
    }
    tempo = observability-component 'Tempo' {
      technology 'Traces'
    }
    loki = observability-component 'Loki' {
      technology 'Logs'
    }
    mimir = observability-component 'Mimir' {
      technology 'Metrics'
    }
    grafana = observability-component 'Grafana' {
      technology 'Visualization'
    }

    alloy -[telemetry]-> tempo 'exports traces'
    alloy -[telemetry]-> loki 'exports logs'
    alloy -[telemetry]-> mimir 'exports metrics'
    grafana -[dependency]-> tempo 'queries traces'
    grafana -[dependency]-> loki 'queries logs'
    grafana -[dependency]-> mimir 'queries metrics'
  }
}
