model {
  core = shared-library 'PetClinic core library' {
    technology 'Kotlin, Spring WebFlux, jOOQ, R2DBC'

    owner = domain-component 'Owner domain'
    pet = domain-component 'Pet domain'
    visit = domain-component 'Visit domain'
    vet = domain-component 'Vet domain'
    model = domain-component 'Shared domain model'

    owner -[dependency]-> model
    owner -[dependency]-> pet
    pet -[dependency]-> model
    pet -[dependency]-> visit
    visit -[dependency]-> model
    vet -[dependency]-> model
    core -[dependency]-> postgres 'jOOQ over R2DBC'
  }
}
