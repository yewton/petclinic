import { core } from 'core'

model {
  fullstack-html = system 'PetClinic HTML' {
    app = application 'PetClinic HTML application' {
      #fullstack-html, #parallel-implementation
      technology 'Spring WebFlux and Thymeleaf'
      metadata {
        implementation-role 'Parallel implementation of the PetClinic feature set with fullstack-htmx'
      }

      pet-owner -[http]-> app 'accesses via HTTP'
      app -[dependency]-> core 'uses shared library'
      app -[otlp]-> grafana-stack.alloy 'exports traces, logs, and metrics'
    }

  }
}
